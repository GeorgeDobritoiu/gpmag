# Gomag API credentials — copy to .env and fill in real values
# Obtain from your Gomag admin panel under API settings

# Required
GOMAG_API_KEY=your_api_key_here
GOMAG_API_SHOP=https://yourshop.gomag.ro

# Optional — defaults shown
GOMAG_BASE_URL=https://api.gomag.ro
GOMAG_USER_AGENT=GomagMCP/1.0
GOMAG_REQUEST_TIMEOUT=30.0
GOMAG_MAX_RETRIES=3
GOMAG_RETRY_BACKOFF_FACTOR=1.0

# Audit logging
GOMAG_AUDIT_LOG_FILE=gomag_audit.jsonl
GOMAG_AUDIT_LOG_MAX_BYTES=10485760
GOMAG_AUDIT_LOG_BACKUP_COUNT=5
GOMAG_AUDIT_LOG_TO_STDERR=true
